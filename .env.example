# Railway otomatik atanır, lokal test için:
PORT=8080

# PostgreSQL Bağlantı (Railway otomatik verir, lokal için):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/demcoin?sslmode=disable

# Veritabanı Ayarları (Railway için isteğe bağlı)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=demcoin

# Kurucu Özel Anahtarı (GEREKLI - Hex formatında, 64 karakter)
DEMCOIN_FOUNDER_KEY=

# Admin Şifresi (Yönetim Konsolu)
ADMIN_SIFRE=kazyontuyozazyontuyozgardas

# Ağ Ayarları
NETWORK_TIMEOUT=30
RECONNECT_INTERVAL=3000

# Fiyat Motoru
INITIAL_PRICE=1.0
PRICE_UPDATE_INTERVAL=5000

# Mining Ayarları
MINING_INTERVAL=10000
MIN_STAKE_AMOUNT=1

# Bot Ayarları
BOT_ENABLED=true
BOT_MESSAGE_INTERVAL=30000
BOT_ACTIVITY_CHANCE=0.3

# Güvenlik
JWT_SECRET=demcoin-secret-2024
SESSION_SECRET=demlicoin-gizli-2024

# Log Seviyesi
LOG_LEVEL=info

# Environment
NODE_ENV=production
